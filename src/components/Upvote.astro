---
interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<upvote-button data-post-id={postId} title="Click to upvote this post!">
  <template shadowrootmode="open">
    <style>
      :host {
        display: inline-block;
        --upvote-background: var(--color-surface-primary, #fafafa);
        --upvote-background-hover: var(--color-surface-hover, #ededed);
        --upvote-background-active: var(--color-neutral-300, #dddddd);
        --upvote-foreground: var(--color-foreground, #111111);
        --upvote-border: var(--color-border-subtle, #d4d4d8);
        --upvote-focus: var(--color-surface-inverse, #111111);
        --upvote-shadow: color-mix(
          in srgb,
          var(--upvote-focus) 14%,
          transparent
        );
      }

      button {
        align-items: center;
        background: var(--upvote-background);
        border: 1px solid var(--upvote-border);
        border-radius: 0.5rem;
        color: var(--upvote-foreground);
        cursor: pointer;
        display: inline-flex;
        gap: 0.35rem;
        justify-content: center;
        line-height: 1;
        min-height: 2.25rem;
        padding: 0.5rem 0.75rem;
        transition:
          background-color 120ms ease,
          border-color 120ms ease,
          box-shadow 120ms ease,
          transform 120ms ease;
        font: 500 0.75rem/1 var(
          --font-mono,
          ui-monospace,
          SFMono-Regular,
          Consolas,
          monospace
        );
      }

      button:hover {
        background: var(--upvote-background-hover);
      }

      button:active {
        background: var(--upvote-background-active);
        transform: translateY(1px);
      }

      button:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px var(--upvote-shadow);
        border-color: var(--upvote-focus);
      }

      button:disabled {
        cursor: wait;
        opacity: 0.65;
        transform: none;
      }

      .count {
        border-left: 1px solid var(--upvote-border);
        margin-left: 0.15rem;
        min-width: 2ch;
        padding-left: 0.5rem;
        text-align: right;
      }

      .icon {
        flex: none;
        font-size: 14px;
        line-height: 1;
      }
    </style>
    <!-- Astro 7 builds now fail on 98.css media queries via Lightning CSS, and this button is too local to justify keeping that dependency. -->
    <button class="upvote-button" type="button">
      <span class="icon" aria-hidden="true">👍</span>
      <span>Upvote</span>
      <span class="count" aria-live="polite">0</span>
    </button>
  </template>
</upvote-button>

<script>
  type UpvoteResponse = {
    upvotes: number;
  };

  class UpvoteButton extends HTMLElement {
    private isSubmitting = false;

    setup = () => {
      const button =
        this.shadowRoot?.querySelector<HTMLButtonElement>("button");

      if (!button) return;

      button.onclick = this.handleClick;
      void this.loadUpvotes();
    };

    private setPending(isPending: boolean) {
      const button =
        this.shadowRoot?.querySelector<HTMLButtonElement>("button");

      if (!button) return;

      button.disabled = isPending;
      button.setAttribute("aria-busy", String(isPending));
    }

    private handleClick = async () => {
      const postId = this.dataset.postId;
      const count = this.shadowRoot?.querySelector<HTMLSpanElement>(".count");

      if (!postId || !count || this.isSubmitting) return;

      this.isSubmitting = true;
      this.setPending(true);

      try {
        const response = await fetch("/api/upvote", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ post_id: postId }),
        });

        if (!response.ok) {
          throw new Error("Failed to update upvote");
        }

        const updated = (await response.json()) as UpvoteResponse;
        count.textContent = String(updated.upvotes);
      } catch (error) {
        console.error(error);
      } finally {
        this.isSubmitting = false;
        this.setPending(false);
      }
    };

    private async loadUpvotes() {
      const postId = this.dataset.postId;
      const count = this.shadowRoot?.querySelector<HTMLSpanElement>(".count");

      if (!postId || !count) return;

      try {
        const response = await fetch(`/api/upvote?post_id=${postId}`);
        if (!response.ok) {
          throw new Error("Failed to GET upvote count");
        }
        const data = (await response.json()) as UpvoteResponse;
        count.textContent = String(data.upvotes);
      } catch (error) {
        console.error(error);
      }
    }
  }

  if (!customElements.get("upvote-button")) {
    customElements.define("upvote-button", UpvoteButton);
  }

  if (!window.__upvotePageLoadBound) {
    const setupUpvoteButtons = () => {
      document
        .querySelectorAll<UpvoteButton>("upvote-button")
        .forEach((button) => button.setup());
    };

    document.addEventListener("astro:page-load", setupUpvoteButtons);
    window.__upvotePageLoadBound = true;
  }
</script>
