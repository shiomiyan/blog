---
import Container from "@components/Container.astro";
import { SITE } from "@constants";
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap justify-between gap-y-2">
      <a href="/" class="text-link font-semibold">
        {SITE.TITLE}
      </a>
      <nav class="flex items-center gap-3" aria-label="メインナビゲーション">
        <a href="/about" class="text-link underline decoration-dotted">About</a>

        <a href="/tags" class="text-link underline decoration-dotted"> Tags </a>

        <a href="/search" class="text-link underline decoration-dotted">
          Search
        </a>

        <a href="/rss.xml" class="text-link underline decoration-dotted">
          Feed
        </a>
      </nav>
    </div>
  </Container>
</header>
