---
import Layout from "@layouts/Layout.astro";
import EntryList from "@components/EntryList.astro";
import { SITE } from "@constants";
import { getCategoryDefinitions } from "@lib/taxonomy";
import { getCollection } from "astro:content";

export const prerender = true;

const categoryDefinitions = getCategoryDefinitions();
const posts = await getCollection("posts")
  .then((entries) => entries.filter((entry) => !entry.data.draft))
  .then((entries) =>
    entries.sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf()),
  );
---

<Layout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <EntryList entries={posts}>
    <div slot="header">
      <h1 class="sr-only">Latest posts</h1>
      <nav aria-label="Categories">
        <p id="category-filter-status" class="sr-only" aria-live="polite"></p>
        <ul class="not-prose flex flex-wrap gap-2">
          <li>
            <button
              type="button"
              class="ui-badge"
              data-category-filter="all"
              aria-controls="entry-list"
              aria-pressed="true"
            >
              All
            </button>
          </li>
          {
            categoryDefinitions.map((category) => (
              <li>
                <button
                  type="button"
                  class="ui-badge"
                  data-category-filter={category.id}
                  aria-controls="entry-list"
                  aria-pressed="false"
                >
                  {category.label}
                </button>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </EntryList>
  <script>
    const applyFilter = (value: string) => {
      const filterButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-category-filter]"),
      );
      const entries = Array.from(
        document.querySelectorAll<HTMLLIElement>("[data-entry]"),
      );
      const status = document.querySelector<HTMLElement>(
        "#category-filter-status",
      );

      if (filterButtons.length === 0 || entries.length === 0) return;

      let visibleCount = 0;
      for (const entry of entries) {
        const categories = (entry.dataset.categories ?? "")
          .split(",")
          .filter(Boolean);
        const isVisible = value === "all" || categories.includes(value);
        entry.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      }

      for (const button of filterButtons) {
        const isActive = button.dataset.categoryFilter === value;
        button.setAttribute("aria-pressed", String(isActive));
        button.classList.toggle("is-active", isActive);
      }
      if (status) status.textContent = `${visibleCount} posts shown`;
    };

    if (document.documentElement.dataset.categoryFilterBound !== "true") {
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest<HTMLButtonElement>(
          "[data-category-filter]",
        );
        if (!button) return;
        applyFilter(button.dataset.categoryFilter ?? "all");
      });
      document.documentElement.dataset.categoryFilterBound = "true";
    }

    if (
      document.documentElement.dataset.categoryFilterPageLoadBound !== "true"
    ) {
      document.addEventListener("astro:page-load", () => applyFilter("all"));
      document.documentElement.dataset.categoryFilterPageLoadBound = "true";
    }
  </script>
</Layout>
