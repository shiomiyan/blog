{
  "name": "blog.736b.moe",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run typecheck && astro check && astro build",
    "check:all": "pnpm run lint && pnpm run typecheck && pnpm run astro -- check && pnpm run textlint",
    "preview": "astro preview",
    "deploy": "pnpm run build && wrangler deploy",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "tsc --NoEmit",
    "cf-typegen": "wrangler types --path ./src/worker-configuration.d.ts",
    "textlint": "textlint \"src/content/posts/**/*.md\" \"src/content/posts/**/*.mdx\"",
    "textlint:checkstyle": "textlint \"src/content/posts/**/*.md\" \"src/content/posts/**/*.mdx\" -f checkstyle",
    "fmt": "prettier --write .",
    "new": "tsx bin/new.ts"
  },
  "devDependencies": {
    "98.css": "^0.1.21",
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "@pagefind/default-ui": "^1.5.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.1",
    "astro": "^7.1.3",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-external-links": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "textlint": "^15.7.1",
    "textlint-filter-rule-allowlist": "^4.0.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unified": "^11.0.5",
    "wrangler": "^4.112.0"
  }
